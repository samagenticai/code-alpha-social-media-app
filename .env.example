# Root example — copy values into Vercel Project Settings → Environment Variables.
# Do NOT put real secrets in this file.
#
# === Backend / Serverless (api/index.js → backend/app.js) ===
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
NODE_ENV=production
CLIENT_URL=https://code-alpha-social-media-app-psi.vercel.app
FRONTEND_URL=https://code-alpha-social-media-app-psi.vercel.app
ALLOWED_ORIGINS=
COOKIE_CROSS_SITE=false
ALLOW_VERCEL_PREVIEWS=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
#
# === Frontend build (Vite) ===
# Set in Vercel as well so `npm run build` embeds the correct API base.
VITE_API_URL=/api
