# API base URL used by Axios (see src/config/api.js + src/services/api.js)
#
# Local development with Vite proxy (recommended):
VITE_API_URL=/api
#
# Or point directly at the local Express server:
# VITE_API_URL=http://localhost:5000/api
#
# Vercel monorepo (same origin, /api rewrite) — keep:
# VITE_API_URL=/api
#
# Separate backend deployment:
# VITE_API_URL=https://your-api.vercel.app/api
