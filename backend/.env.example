PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) for CORS — MUST match your live Vercel URL exactly (no trailing slash)
# Current production deployment:
CLIENT_URL=https://code-alpha-social-media-app-psi.vercel.app
# Alias also supported:
# FRONTEND_URL=https://code-alpha-social-media-app-psi.vercel.app
# Comma-separated extra origins (custom domains, etc.):
# ALLOWED_ORIGINS=https://www.example.com

# Local development example (use only in local backend/.env — not on Vercel Production):
# CLIENT_URL=http://localhost:5173

# Allow this project's Vercel preview deployment hosts through CORS (optional)
# ALLOW_VERCEL_PREVIEWS=true

# Set true ONLY if frontend and API are on different sites (separate Vercel projects)
# COOKIE_CROSS_SITE=true

# Admin dashboard (backend only)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_NAME=

# Cloudinary (backend only — never put the secret in Vite/frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
