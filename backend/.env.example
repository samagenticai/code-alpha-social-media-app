PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) for CORS — set to your Vercel frontend URL in production
# Example production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
# Alias also supported:
# FRONTEND_URL=https://your-app.vercel.app
# Comma-separated extra origins (preview deployments, etc.):
# ALLOWED_ORIGINS=https://your-app-git-main.vercel.app

# Set true ONLY if frontend and API are on different sites (separate Vercel projects)
# COOKIE_CROSS_SITE=true

# Allow *.vercel.app preview deployments through CORS (optional)
# ALLOW_VERCEL_PREVIEWS=true

# Admin dashboard (backend only)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_NAME=

# Cloudinary (backend only — never put the secret in Vite/frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
